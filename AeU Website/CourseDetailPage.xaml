<Window x:Class="EduPlus.CourseDetailPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course Detail - EduPlus" Height="895" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="pack://application:,,,/Fonts/#Poppins">

    <Window.Resources>
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="MontserratFont">pack://application:,,,/Fonts/#Montserrat</FontFamily>

        <SolidColorBrush x:Key="PrimaryColor" Color="#32625A"/>
        <SolidColorBrush x:Key="DarkColor" Color="#1E484A"/>
        <SolidColorBrush x:Key="LightBackground" Color="#E8E8E8"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Margin="40,40,40,60">
                    <TextBlock Text="EduPlus" FontSize="28" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               Foreground="White"/>
                    <TextBlock Text="Smart e-learning platform" FontSize="11" 
                               Foreground="#B8D3D2" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel>
                    <!-- Dashboard -->
                    <Border Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToDashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Site home -->
                    <Border Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="Site home" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- My Courses - Active -->
                    <Border Background="#2A5550" Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToMyCourses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="My Courses" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource LightBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="White" Padding="40,25" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Course Detail" FontSize="32" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Bell Icon -->
                        <Border Width="40" Height="40" Background="Transparent" Margin="0,0,20,0" Cursor="Hand">
                            <TextBlock Text="🔔" FontSize="22" Foreground="#FF4444" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Profile -->
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="40" Height="40" Fill="#333333" Margin="0,0,12,0"/>
                            <TextBlock Text="Fajar Rizky" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,40">

                    <!-- Course Header Banner -->
                    <Border CornerRadius="15" Margin="0,0,0,30" Height="200">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6B7FD7" Offset="0"/>
                                <GradientStop Color="#B77FD7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="40,30">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CHC401" FontSize="14" Foreground="White" Margin="0,0,0,10" FontWeight="SemiBold"/>
                                <TextBlock Text="Human Computer Interaction" FontSize="36" FontWeight="Bold" 
                                           FontFamily="{StaticResource MontserratFont}"
                                           Foreground="White" Margin="0,0,0,12"/>
                                <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                                           FontSize="14" Foreground="White" Opacity="0.9" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                        <TextBlock Text="📚" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="16 Lessons" FontSize="14" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👥" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="110 Students" FontSize="14" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tab Navigation -->
                    <Border Background="White" CornerRadius="10" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                        </Border.Effect>
                        <UniformGrid Columns="3" Rows="1">
                            <!-- Lessons Tab -->
                            <Border x:Name="LessonsTab" Background="#6B7FD7" CornerRadius="10,0,0,10" 
                                    Padding="0,15" Cursor="Hand" MouseLeftButtonDown="ShowLessons">
                                <TextBlock Text="Lessons" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Assignment Tab -->
                            <Border x:Name="AssignmentTab" Background="Transparent" Padding="0,15" 
                                    Cursor="Hand" MouseLeftButtonDown="ShowAssignment">
                                <TextBlock Text="Assignment" FontSize="16" Foreground="#666666" 
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Quiz Tab -->
                            <Border x:Name="QuizTab" Background="Transparent" CornerRadius="0,10,10,0" 
                                    Padding="0,15" Cursor="Hand" MouseLeftButtonDown="ShowQuiz">
                                <TextBlock Text="Quiz" FontSize="16" Foreground="#666666" 
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- Content Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LESSONS SECTION -->
                        <StackPanel x:Name="LessonsSection" Grid.Column="0" Margin="0,0,20,0" Visibility="Visible">
                            <TextBlock Text="Course Lessons" FontSize="22" FontWeight="Bold" 
                                       FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,20"/>

                            <!-- Lesson 1 - Completed -->
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15" 
                                    Cursor="Hand" MouseLeftButtonDown="NavigateToLesson">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="50" Height="50" Background="#10B981" 
                                            CornerRadius="8" Margin="0,0,15,0">
                                        <TextBlock Text="✓" FontSize="28" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Introduction to HCI" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="45 Minutes • Video" FontSize="13" Foreground="#888888"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#10B981" CornerRadius="15" 
                                            Padding="15,6" VerticalAlignment="Center">
                                        <TextBlock Text="Completed" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Lesson 2 - Completed -->
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15" 
                                    Cursor="Hand" MouseLeftButtonDown="NavigateToLesson">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="50" Height="50" Background="#10B981" 
                                            CornerRadius="8" Margin="0,0,15,0">
                                        <TextBlock Text="✓" FontSize="28" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Users Research Methods" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="60 Minutes • Video" FontSize="13" Foreground="#888888"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#10B981" CornerRadius="15" 
                                            Padding="15,6" VerticalAlignment="Center">
                                        <TextBlock Text="Completed" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Lesson 3 - In Progress -->
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15" 
                                    Cursor="Hand" MouseLeftButtonDown="NavigateToLesson">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="50" Height="50" Background="#6B7FD7" 
                                            CornerRadius="8" Margin="0,0,15,0">
                                        <TextBlock Text="3" FontSize="24" Foreground="White" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Design Principles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="45 Minutes • Interactive" FontSize="13" Foreground="#888888"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#FFA726" CornerRadius="15" 
                                            Padding="15,6" VerticalAlignment="Center">
                                        <TextBlock Text="In Progress" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Lesson 4 - Locked -->
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="50" Height="50" Background="#E0E0E0" 
                                            CornerRadius="8" Margin="0,0,15,0">
                                        <TextBlock Text="4" FontSize="24" Foreground="#999999" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Design Principles" FontSize="16" FontWeight="SemiBold" 
                                                   Foreground="#999999" Margin="0,0,0,4"/>
                                        <TextBlock Text="45 Minutes • Interactive" FontSize="13" Foreground="#BBBBBB"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#EF5350" CornerRadius="15" 
                                            Padding="15,6" VerticalAlignment="Center">
                                        <TextBlock Text="Locked" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Lesson 5 - Locked -->
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="50" Height="50" Background="#E0E0E0" 
                                            CornerRadius="8" Margin="0,0,15,0">
                                        <TextBlock Text="5" FontSize="24" Foreground="#999999" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Design Principles" FontSize="16" FontWeight="SemiBold" 
                                                   Foreground="#999999" Margin="0,0,0,4"/>
                                        <TextBlock Text="45 Minutes • Interactive" FontSize="13" Foreground="#BBBBBB"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#EF5350" CornerRadius="15" 
                                            Padding="15,6" VerticalAlignment="Center">
                                        <TextBlock Text="Locked" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ASSIGNMENT SECTION -->
                        <StackPanel x:Name="AssignmentSection" Grid.Column="0" Margin="0,0,20,0" Visibility="Collapsed">
                            <TextBlock Text="Assignment" FontSize="22" FontWeight="Bold" 
                                       FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,20"/>

                            <!-- Assignment 1 - Submitted -->
                            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="50" Height="50" Background="#10B981" CornerRadius="8" Margin="0,0,15,0">
                                                <TextBlock Text="📝" FontSize="28" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="User Interface" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="Design Project" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="#10B981" CornerRadius="15" Padding="15,6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Submitted" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Create a complete UI design for a mobile banking application including wireframes and high fidelity mockups." 
                                               FontSize="13" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="20"/>

                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📅" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Submitted: Dec 20, 2025" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="✓" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="On time" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="📎" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="report.pdf • 2.4 MB" FontSize="12" Foreground="#666666"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View Submission" Background="Transparent" Foreground="#10B981" 
                                                BorderBrush="#10B981" BorderThickness="2" Padding="25,10" 
                                                FontSize="14" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="Resubmit" Background="#E0E0E0" Foreground="#666666" 
                                                BorderThickness="0" Padding="35,10" FontSize="14" 
                                                FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Assignment 2 - Pending -->
                            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="50" Height="50" Background="#6B7FD7" CornerRadius="8" Margin="0,0,15,0">
                                                <TextBlock Text="📝" FontSize="24" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Usability" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="Testing Report" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="#6B7FD7" CornerRadius="15" Padding="15,6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Pending" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Conduct usability testing on a website and write a comprehensive report with findings and recommendations." 
                                               FontSize="13" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="20"/>

                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📅" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Due: Dec 25, 2025" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="⏰" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="8 days left" FontSize="12" Foreground="#6B7FD7" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="🎯" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Max Score: 100" FontSize="12" Foreground="#666666"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View Details" Background="Transparent" Foreground="#6B7FD7" 
                                                BorderBrush="#6B7FD7" BorderThickness="2" Padding="25,10" 
                                                FontSize="14" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="Submit Work" Background="#6B7FD7" Foreground="White" 
                                                BorderThickness="0" Padding="30,10" FontSize="14" 
                                                FontWeight="SemiBold" Cursor="Hand" Click="NavigateToSubmitAssignment">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- QUIZ SECTION -->
                        <StackPanel x:Name="QuizSection" Grid.Column="0" Margin="0,0,20,0" Visibility="Collapsed">
                            <TextBlock Text="Quiz" FontSize="22" FontWeight="Bold" 
                                       FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,20"/>

                            <!-- Quiz 1 - Completed -->
                            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="50" Height="50" Background="#10B981" CornerRadius="8" Margin="0,0,15,0">
                                                <TextBlock Text="✓" FontSize="28" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Quiz 1" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="Introduction to HCI Concepts" FontSize="14" Foreground="#666666"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="#10B981" CornerRadius="15" Padding="15,6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Completed" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📝" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="10 Questions" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="⏱" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="15 Minutes" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📅" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Submitted: Dec 15, 2025" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="⭐" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Score: 85/100" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="View Result" Background="#E8F5E9" Foreground="#10B981" 
                                            BorderBrush="#10B981" BorderThickness="2" Padding="30,10" 
                                            FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Quiz 2 - Available -->
                            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="50" Height="50" Background="#6B7FD7" CornerRadius="8" Margin="0,0,15,0">
                                                <TextBlock Text="📝" FontSize="24" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Quiz 2" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="User Research Methods" FontSize="14" Foreground="#666666"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Background="#6B7FD7" CornerRadius="15" Padding="15,6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Available" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Test your understanding of user research methodologies, interview techniques, and data analysis approaches." 
                                               FontSize="13" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="20"/>

                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📝" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="15 Questions" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="⏱" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="20 Minutes" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📅" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Available: Dec 18, 2025" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="🎯" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Max Score: 100" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="Start Quiz" Background="#6B7FD7" Foreground="White" 
                                            BorderThickness="0" Padding="35,10" FontSize="14" 
                                            FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left" 
                                            Click="NavigateToQuiz">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT SIDEBAR - Progress Info -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <!-- Your Progress Card -->
                            <Border Background="White" CornerRadius="15" Padding="25" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Your Progress" FontSize="20" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,15"/>

                                    <TextBlock Text="50%" FontSize="48" FontWeight="Bold" 
                                               HorizontalAlignment="Center" Margin="0,10,0,20"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Completed" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="2/5 Lessons" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Time Spent" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="1 h 45m" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Next Lesson" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Lesson 3" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Instructor Card -->
                            <Border Background="White" CornerRadius="15" Padding="25" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Instructor" FontSize="20" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,15"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="50" Height="50" Fill="#333333" Margin="0,0,15,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Mr. Riza" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="System Analyst" FontSize="13" Foreground="#666666"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Course Detail Info Card -->
                            <Border Background="White" CornerRadius="15" Padding="25">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Course Detail" FontSize="20" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,15"/>

                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Start Date" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Jan 11, 2025" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="End Date" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Sept 14, 2025" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Language" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="English" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
