<Window x:Class="EduPlus.MyCoursesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Courses - EduPlus" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="pack://application:,,,/Fonts/#Poppins">

    <Window.Resources>
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="MontserratFont">pack://application:,,,/Fonts/#Montserrat</FontFamily>

        <SolidColorBrush x:Key="PrimaryColor" Color="#32625A"/>
        <SolidColorBrush x:Key="DarkColor" Color="#1E484A"/>
        <SolidColorBrush x:Key="LightBackground" Color="#E8E8E8"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Margin="40,40,40,60">
                    <TextBlock Text="EduPlus" FontSize="32" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               Foreground="White"/>
                    <TextBlock Text="Smart e-learning platform" FontSize="12" 
                               Foreground="#B8D3D2" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel>
                    <!-- Dashboard -->
                    <Border Padding="40,18" Cursor="Hand" MouseLeftButtonDown="NavigateToDashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="18" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Text="Dashboard" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Site home -->
                    <Border Padding="40,18" Cursor="Hand" MouseLeftButtonDown="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="18" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Text="Site home" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- My Courses - Active -->
                    <Border Background="#2A5550" Padding="40,18" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" FontSize="18" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Text="My Courses" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                   
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource LightBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="White" Padding="40,25" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="My Course" FontSize="32" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Bell Icon -->
                        <Border Width="40" Height="40" Background="Transparent" Margin="0,0,20,0" Cursor="Hand">
                            <TextBlock Text="🔔" FontSize="22" Foreground="#FF4444" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Profile -->
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="40" Height="40" Fill="#333333" Margin="0,0,12,0"/>
                            <TextBlock Text="Fajar Rizky" FontSize="16" FontWeight="SemiBold" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,40">
                    <!-- Current Task Header -->
                    <TextBlock Text="Current Course" FontSize="24" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               Margin="0,0,0,20"/>

                    <!-- Search Box -->
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                        </Border.Effect>
                        <TextBox Text="Search" FontSize="14" Foreground="#999999" 
                                 BorderThickness="0" Background="Transparent"/>
                    </Border>

                    <!-- Course Cards Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Discrete Mathematics -->
                        <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="10" 
                                Padding="0" Margin="12" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icon -->
                                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10,10,0,0">
                                    <TextBlock Text="&lt;/&gt;" FontSize="56" Foreground="#666666" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </Border>

                                <!-- Course Info -->
                                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                                    <TextBlock Text="CDM309" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Discrete Mathematics" FontSize="17" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                                               FontSize="11" Foreground="#666666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="16 Lessons" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="120 Students" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: E-Commerce -->
                        <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="10" 
                                Padding="0" Margin="12" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#4A90E2" CornerRadius="10,10,0,0">
                                    <TextBlock Text="🛒" FontSize="56" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                                    <TextBlock Text="CEC200" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="E-Commerce" FontSize="17" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                                               FontSize="11" Foreground="#666666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="20 Lessons" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="135 Students" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: Human Computer Interaction -->
                        <!-- Card 3: Human Computer Interaction - TAMBAHKAN EVENT -->
                        <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="10" 
        Padding="0" Margin="12" Cursor="Hand" MouseLeftButtonDown="NavigateToCourseDetail">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#8B5CF6" CornerRadius="10,10,0,0">
                                    <TextBlock Text="🖱️" FontSize="56" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                                    <TextBlock Text="CHC401" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Human Computer Interaction" FontSize="17" FontWeight="Bold" 
                       FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                       FontSize="11" Foreground="#666666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="16 Lessons" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="110 Students" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <!-- Card 4: Management Information Systems -->
                        <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="10" 
                                Padding="0" Margin="12" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#10B981" CornerRadius="10,10,0,0">
                                    <TextBlock Text="📊" FontSize="56" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                                    <TextBlock Text="CIS307" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Management Information Systems" FontSize="17" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                                               FontSize="11" Foreground="#666666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="22 Lessons" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="140 Students" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 5: Object-Oriented Programming -->
                        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" 
                                Padding="0" Margin="12" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F59E0B" CornerRadius="10,10,0,0">
                                    <TextBlock Text="⚙️" FontSize="56" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                                    <TextBlock Text="OOP210" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Object-Oriented Programming" FontSize="17" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                                               FontSize="11" Foreground="#666666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="23 Lessons" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="127 Students" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 6: Relational Database -->
                        <Border Grid.Row="1" Grid.Column="2" Background="White" CornerRadius="10" 
                                Padding="0" Margin="12" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#EF4444" CornerRadius="10,10,0,0">
                                    <TextBlock Text="🗄️" FontSize="56" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                                    <TextBlock Text="RDBMS220" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Relational Database" FontSize="17" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bachelor of Information &amp; Communication Technology" 
                                               FontSize="11" Foreground="#666666" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="18 Lessons" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="125 Students" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
