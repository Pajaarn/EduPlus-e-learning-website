<Window x:Class="EduPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduPlus" Height="796" Width="1400"
        WindowStartupLocation="CenterScreen"
        FontFamily="pack://application:,,,/Fonts/#Poppins">

    <Window.Resources>
        <!-- Font Families -->
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="MontserratFont">pack://application:,,,/Fonts/#Montserrat</FontFamily>

        <!-- Colors - Updated dengan palette baru -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#32625A"/>
        <SolidColorBrush x:Key="DarkColor" Color="#1E484A"/>
        <SolidColorBrush x:Key="DarkestColor" Color="#0E303B"/>
        <SolidColorBrush x:Key="GrayColor" Color="#B1B1B1"/>
        <SolidColorBrush x:Key="LightBackground" Color="#F5F5F5"/>

        <!-- Course Card Style -->
        <Style x:Key="CourseCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Feature Card Style -->
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkestColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="35,15"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource MontserratFont}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header - WITH TAGLINE & SEPARATOR -->
        <!-- Header - WITH TAGLINE & GRAY SEPARATOR -->
        <Grid VerticalAlignment="Top" Background="{StaticResource PrimaryColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo dengan Tagline -->
                <StackPanel Margin="60,0,60,0" VerticalAlignment="Center">
                    <TextBlock Text="EduPlus" FontSize="24" FontWeight="Bold" 
                       FontFamily="{StaticResource MontserratFont}"
                       Foreground="White"/>
                    <TextBlock Text="Smart e-learning platform" FontSize="11" 
                       FontFamily="{StaticResource PoppinsFont}"
                       Foreground="#B8D3D2" 
                       Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Home" FontSize="14" Foreground="White" Margin="20,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="Dashboard" FontSize="14" Foreground="White" Margin="20,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="Announcements" FontSize="14" Foreground="White" Margin="20,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="English (en)" FontSize="14" Foreground="White" Margin="20,0" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>

                <!-- Login/Register -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="60,0" VerticalAlignment="Center">
                    <Ellipse Width="24" Height="24" Fill="White" Margin="0,0,10,0"/>
                    <TextBlock Text="Login/Register" FontSize="14" Foreground="White" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Gray Line Separator - UPDATED -->
            <Rectangle Grid.Row="1" Fill="#999999" Height="1"/>
        </Grid>



        <!-- Scrollable Content -->
        <ScrollViewer Margin="0,92,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Hero Section -->
                <Grid Background="{StaticResource PrimaryColor}" Height="692">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,60,40,60" MaxWidth="500">
                        <TextBlock FontSize="48" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   Foreground="White" TextWrapping="Wrap" LineHeight="58" Margin="0,0,0,20">
                            <Run Text="Stay on top of your"/>
                            <LineBreak/>
                            <Run Text="classes with EduPlus."/>
                        </TextBlock>
                        <TextBlock FontSize="15" Foreground="#E8E8E8" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,35">
                            <Run Text="Access your courses, exam schedule,"/>
                            <LineBreak/>
                            <Run Text="and announcements in one simple"/>
                            <LineBreak/>
                            <Run Text="dashboard."/>
                        </TextBlock>
                        <Button Content="Get Started" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Gambar Student -->
                    <Image Grid.Column="1" 
                           Source="pack://application:,,,/image/Frame 5.png"
                           Stretch="Uniform"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           MaxWidth="650" 
                           MaxHeight="800"/>
                </Grid>

                <!-- Description Section -->
                <Border Background="White" Height="400">
                    <StackPanel VerticalAlignment="Center" Margin="100,0">
                        <TextBlock Text="EduPlus" FontSize="34" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   HorizontalAlignment="Center" Margin="0,0,0,25"/>
                        <TextBlock TextAlignment="Center" FontSize="15" Foreground="#666666" 
                                   Margin="200,0,200,0" TextWrapping="Wrap" LineHeight="26">
                            EduPlus is an e-learning platform designed to serve as an online learning management system (LMS) specifically tailored for universities. Operating within the university environment, it enables lecturers and students to manage course materials, assignments, and assessments in an organized way, helping blended learning run more efficiently and keeping learning objectives on track.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Features Section -->
                <Border Background="{StaticResource LightBackground}" Height="550">
                    <StackPanel VerticalAlignment="Center" Margin="100,0">
                        <TextBlock FontSize="32" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,50">
                            <Run Text="Online learning wherever and"/>
                            <LineBreak/>
                            <Run Text="whenever"/>
                        </TextBlock>

                        <UniformGrid Columns="3" Margin="20,0">
                            <!-- Blended Learning -->
                            <Border Style="{StaticResource FeatureCard}" MaxWidth="340" Height="300" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Border Width="70" Height="70" 
                                            Background="#F0F0F0" 
                                            CornerRadius="35"
                                            HorizontalAlignment="Center" 
                                            Margin="0,15,0,25">
                                        <TextBlock Text="💻" FontSize="34" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Blended Learning" FontSize="19" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}"
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock TextAlignment="Center" FontSize="13" Foreground="#666666" 
                                               TextWrapping="Wrap" LineHeight="20" Margin="10,0">
                                        Support interaction is directly between lecturers and students, making learning outcomes easier to meet and facilitate online learning.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Mobile Learning -->
                            <Border Style="{StaticResource FeatureCard}" MaxWidth="340" Height="300" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Border Width="70" Height="70" 
                                            Background="#F0F0F0" 
                                            CornerRadius="35"
                                            HorizontalAlignment="Center" 
                                            Margin="0,15,0,25">
                                        <TextBlock Text="📱" FontSize="34" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Mobile Learning" FontSize="19" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}"
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock TextAlignment="Center" FontSize="13" Foreground="#666666" 
                                               TextWrapping="Wrap" LineHeight="20" Margin="10,0">
                                        Enable students to access course materials through their mobile device from anywhere in flexibility place or from distance.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Organized Learning -->
                            <Border Style="{StaticResource FeatureCard}" MaxWidth="340" Height="300" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Border Width="70" Height="70" 
                                            Background="#F0F0F0" 
                                            CornerRadius="35"
                                            HorizontalAlignment="Center" 
                                            Margin="0,15,0,25">
                                        <TextBlock Text="📚" FontSize="34" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Organized Learning" FontSize="19" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}"
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock TextAlignment="Center" FontSize="13" Foreground="#666666" 
                                               TextWrapping="Wrap" LineHeight="20" Margin="10,0">
                                        Provide a structured learning environment, helping lecturers deliver the lectures and students to manage the learning more efficiently.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Announcements Section -->
                <Border Background="White" Height="520">
                    <StackPanel VerticalAlignment="Center" Margin="100,0">
                        <TextBlock Text="Announcement" FontSize="32" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   HorizontalAlignment="Center" Margin="0,0,0,50"/>

                        <UniformGrid Columns="3" Margin="20,0">
                            <!-- Announcement Card 1 -->
                            <Border Style="{StaticResource CourseCard}" MaxWidth="350" Height="260" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Border Background="#E8E8E8" Height="150" CornerRadius="6" Margin="0,0,0,20">
                                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" 
                                               FontFamily="{StaticResource MontserratFont}"
                                               TextWrapping="Wrap">
                                        <Run Text="Guidelines Final"/>
                                        <LineBreak/>
                                        <Run Text="Assessment"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Announcement Card 2 -->
                            <Border Style="{StaticResource CourseCard}" MaxWidth="350" Height="260" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Border Background="#C4B5A0" Height="150" CornerRadius="6" Margin="0,0,0,20">
                                        <TextBlock Text="🏫" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Exam Room Allocation" FontSize="17" FontWeight="SemiBold" 
                                               FontFamily="{StaticResource MontserratFont}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Announcement Card 3 -->
                            <Border Style="{StaticResource CourseCard}" MaxWidth="350" Height="260" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Border Background="#D5D5D5" Height="150" CornerRadius="6" Margin="0,0,0,20">
                                        <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" 
                                               FontFamily="{StaticResource MontserratFont}"
                                               TextWrapping="Wrap">
                                        <Run Text="Official Telegram For"/>
                                        <LineBreak/>
                                        <Run Text="Final Exam Support"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Popular Courses Section - ULTRA CONSISTENT dengan Grid -->
                <Border Background="{StaticResource LightBackground}" Padding="100,60">
                    <StackPanel>
                        <TextBlock Text="Popular Courses" FontSize="32" FontWeight="Bold" 
                   FontFamily="{StaticResource MontserratFont}"
                   Margin="0,0,0,8"/>
                        <TextBlock Text="Browse Our Top Courses" FontSize="15" Foreground="#777777" Margin="0,0,0,40"/>

                        <!-- Grid Container untuk Semua Cards -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="340"/>
                                <RowDefinition Height="340"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ROW 1, COL 1: Discrete Mathematics -->
                            <Border Grid.Row="0" Grid.Column="0" 
                    Background="White" CornerRadius="10" 
                    Padding="20" Margin="12" 
                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10">
                                        <TextBlock Text="&lt;/&gt;" FontSize="56" Foreground="#666666" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="CS1102" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Discrete Mathematics" FontSize="17" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bachelor of Informatics &amp; Computer" FontSize="12" Foreground="#888888" 
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="16 Module" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="107 Students" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 1, COL 2: E-Commerce -->
                            <Border Grid.Row="0" Grid.Column="1" 
                    Background="White" CornerRadius="10" 
                    Padding="20" Margin="12" 
                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#4A90E2" CornerRadius="10">
                                        <TextBlock Text="🛒" FontSize="56" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="IS1102" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,6"/>
                                        <TextBlock Text="E-Commerce" FontSize="17" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bachelor of E-Business &amp; E-commerce" FontSize="12" Foreground="#888888" 
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="24 Courses" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="138 Students" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 1, COL 3: Human Computer Interaction -->
                            <Border Grid.Row="0" Grid.Column="2" 
                    Background="White" CornerRadius="10" 
                    Padding="20" Margin="12" 
                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#8B5CF6" CornerRadius="10">
                                        <TextBlock Text="🖱️" FontSize="56" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="CS1304" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Human Computer Interaction" FontSize="17" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bachelor of Informatics &amp; Technology" FontSize="12" Foreground="#888888" 
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="13 module" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="69 Students" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 2, COL 1: Management Information System -->
                            <Border Grid.Row="1" Grid.Column="0" 
                    Background="White" CornerRadius="10" 
                    Padding="20" Margin="12" 
                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#10B981" CornerRadius="10">
                                        <TextBlock Text="📊" FontSize="56" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="CS1301" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Management Information System" FontSize="17" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Text="Bachelor of Management &amp; Technology" FontSize="12" Foreground="#888888" 
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="20 module" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="145 Students" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 2, COL 2: Object-Oriented Programming -->
                            <Border Grid.Row="1" Grid.Column="1" 
                    Background="White" CornerRadius="10" 
                    Padding="20" Margin="12" 
                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#F59E0B" CornerRadius="10">
                                        <TextBlock Text="⚙️" FontSize="56" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="DP1242" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Object-Oriented Programming" FontSize="17" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Text="Diploma of Technology" FontSize="12" Foreground="#888888" 
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="18 Course" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="127 Students" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 2, COL 3: Relational Database -->
                            <Border Grid.Row="1" Grid.Column="2" 
                    Background="White" CornerRadius="10" 
                    Padding="20" Margin="12" 
                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#EF4444" CornerRadius="10">
                                        <TextBlock Text="🗄️" FontSize="56" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="IS3532" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Relational Database" FontSize="17" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bachelor of Data Science Technology" FontSize="12" Foreground="#888888" 
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="16 Courses" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="176 Students" FontSize="11" Foreground="#888888"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>





                <!-- Footer / Feedback Section -->
                <Grid Background="{StaticResource DarkColor}" Height="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="100,50">
                        <TextBlock Text="Feedback" FontSize="26" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock FontSize="26" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   Foreground="White" Margin="0,0,0,20">
                            <Run Text="Trusted by"/>
