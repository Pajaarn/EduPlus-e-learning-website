<Window x:Class="EduPlus.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - EduPlus" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="pack://application:,,,/Fonts/#Poppins">

    <Window.Resources>
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="MontserratFont">pack://application:,,,/Fonts/#Montserrat</FontFamily>

        <SolidColorBrush x:Key="PrimaryColor" Color="#32625A"/>
        <SolidColorBrush x:Key="LightPrimary" Color="#4A8078"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFB84D"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE - Decorative Background -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <Grid>
                <!-- Decorative Circles -->
                <Ellipse Width="400" Height="400" Fill="#2A5550" Opacity="0.3" 
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
                <Ellipse Width="300" Height="300" Fill="#4A8078" Opacity="0.2" 
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80"/>
                <Ellipse Width="200" Height="200" Fill="#FFB84D" Opacity="0.15" 
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,200,0,0"/>

                <!-- Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="80,0">
                    <!-- Logo Icon -->
                    <Border Width="120" Height="120" Background="White" CornerRadius="30" 
                            Margin="0,0,0,40">
                        <TextBlock Text="📚" FontSize="60" HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Branding Text -->
                    <TextBlock Text="EduPlus" FontSize="48" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Smart e-learning platform" FontSize="18" 
                               Foreground="#B8D3D2" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Empower your learning journey with interactive courses and assessments" 
                               FontSize="14" Foreground="#B8D3D2" TextWrapping="Wrap" 
                               TextAlignment="Center" LineHeight="24" MaxWidth="400"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT SIDE - Login Form -->
        <Border Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">

                <!-- Welcome Text -->
                <TextBlock Text="Welcome Back!" FontSize="36" FontWeight="Bold" 
                           FontFamily="{StaticResource MontserratFont}"
                           Foreground="#1E484A" Margin="0,0,0,10"/>

                <TextBlock Text="Sign in to continue your learning" FontSize="15" 
                           Foreground="#6B7280" Margin="0,0,0,50"/>

                <!-- Email Field -->
                <TextBlock Text="Email" FontSize="14" FontWeight="SemiBold" 
                           Foreground="#374151" Margin="0,0,0,8"/>

                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="15,12" Margin="0,0,0,20">
                    <TextBox x:Name="EmailTextBox" BorderThickness="0" Background="Transparent" 
                             FontSize="15" Foreground="#374151"
                             VerticalAlignment="Center"/>
                </Border>

                <!-- Password Field -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#374151" HorizontalAlignment="Left"/>

                    <TextBlock Text="Forgot Password?" FontSize="13" Foreground="{StaticResource PrimaryColor}" 
                               HorizontalAlignment="Right" Cursor="Hand" 
                               MouseLeftButtonDown="ForgotPassword_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="15,12" Margin="0,0,0,30">
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent" 
                                     FontSize="15" Foreground="#374151" 
                                     VerticalAlignment="Center"/>

                        <TextBox x:Name="PasswordTextBox" BorderThickness="0" Background="Transparent" 
                                 FontSize="15" Foreground="#374151" 
                                 VerticalAlignment="Center" Visibility="Collapsed"/>

                        <!-- Show/Hide Password Toggle -->
                        <Border Width="35" Height="35" Background="Transparent" 
                                HorizontalAlignment="Right" Cursor="Hand"
                                MouseLeftButtonDown="TogglePassword_Click">
                            <TextBlock x:Name="PasswordToggleIcon" Text="👁" FontSize="18" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sign In Button -->
                <Button Content="Sign In" Background="{StaticResource AccentColor}" 
                        Foreground="White" BorderThickness="0" 
                        Padding="0,16" FontSize="16" FontWeight="Bold" 
                        Cursor="Hand" Margin="0,0,0,25"
                        Click="SignInButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                Padding="{TemplateBinding Padding}" 
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E5A743"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
