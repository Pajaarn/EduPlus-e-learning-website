<Window x:Class="EduPlus.SubmitAssignmentPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submit Assignment - EduPlus" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="pack://application:,,,/Fonts/#Poppins">

    <Window.Resources>
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="MontserratFont">pack://application:,,,/Fonts/#Montserrat</FontFamily>

        <SolidColorBrush x:Key="PrimaryColor" Color="#32625A"/>
        <SolidColorBrush x:Key="DarkColor" Color="#1E484A"/>
        <SolidColorBrush x:Key="LightBackground" Color="#E8E8E8"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Margin="40,40,40,60">
                    <TextBlock Text="EduPlus" FontSize="28" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               Foreground="White"/>
                    <TextBlock Text="Smart e-learning platform" FontSize="11" 
                               Foreground="#B8D3D2" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel>
                    <!-- Dashboard -->
                    <Border Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToDashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Site home -->
                    <Border Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="Site home" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- My Courses - Active -->
                    <Border Background="#2A5550" Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToMyCourses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="My Courses" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource LightBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="White" Padding="40,25" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Back Button & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="35" Height="35" Background="Transparent" Cursor="Hand" 
                                Margin="0,0,15,0" MouseLeftButtonDown="BackToCourseDetail">
                            <TextBlock Text="←" FontSize="24" Foreground="#333333" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Submit Assignment" FontSize="32" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Bell Icon -->
                        <Border Width="40" Height="40" Background="Transparent" Margin="0,0,20,0" Cursor="Hand">
                            <TextBlock Text="🔔" FontSize="22" Foreground="#FF4444" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Profile -->
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="40" Height="40" Fill="#333333" Margin="0,0,12,0"/>
                            <TextBlock Text="Fajar Rizky" FontSize="16" FontWeight="SemiBold" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,40">

                    <!-- Assignment Header Banner - FIXED -->
                    <Border CornerRadius="15" Margin="0,0,0,30" Padding="40,30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6B7FD7" Offset="0"/>
                                <GradientStop Color="#B77FD7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel>
                            <TextBlock Text="CHC401" FontSize="14" Foreground="White" Margin="0,0,0,10" FontWeight="SemiBold"/>
                            <TextBlock Text="Usability Testing Report" FontSize="32" FontWeight="Bold" 
                   FontFamily="{StaticResource MontserratFont}" Foreground="White" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Due: December 20, 2024" FontSize="14" Foreground="White"/>

                                <!-- HAPUS Border kuning, langsung tampilkan text saja -->
                                <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                                    <TextBlock Text="⏱️" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="8 days remaining" FontSize="14" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Max Score: 100 points" FontSize="14" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>


                    <!-- Content Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SECTION - Submission Form -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Border Background="White" CornerRadius="15" Padding="30">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📝 Submission Form" FontSize="20" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,25"/>

                                    <!-- Submission Title -->
                                    <TextBlock Text="Submission Title" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">
                                        <Run Text="*" Foreground="Red"/>
                                    </TextBlock>
                                    <TextBox x:Name="TitleTextBox" 
                                             FontSize="14" 
                                             Padding="12"
                                             Margin="0,0,0,20"
                                             Background="#F5F5F5"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                        <TextBox.Text>e.g., Mobile Banking App UI Design - Fajar Rizky</TextBox.Text>
                                    </TextBox>

                                    <!-- Description / Notes -->
                                    <TextBlock Text="Description / Notes" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="DescriptionTextBox"
                                             FontSize="13"
                                             Padding="12"
                                             Height="120"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,20"
                                             Background="#F5F5F5"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1"
                                             Foreground="#999999">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                        <TextBox.Text>Describe your work, approach, tools used, or any notes for the instructor...</TextBox.Text>
                                    </TextBox>

                                    <!-- Upload Your Work-->
                                    <TextBlock Text="Upload Your Work" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">
    <Run Text="*" Foreground="Red"/>
                                    </TextBlock>

                                    <!-- Ganti Border dengan Rectangle untuk dashed border -->
                                    <Border CornerRadius="10" Padding="40" Margin="0,0,0,25" Background="#FAFAFA">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.05" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <!-- Dashed Border using Rectangle -->
                                            <Rectangle Stroke="#CCCCCC" StrokeThickness="2" RadiusX="10" RadiusY="10" 
                   StrokeDashArray="4 2" Fill="Transparent"/>

                                            <!-- Content -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5">
                <Run Text="Drag &amp; Drop Files Here"/>
                                                </TextBlock>
                                                <TextBlock FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Run Text="or "/>
                <Run Text="browse from your computer" Foreground="#6B7FD7" 
                     TextDecorations="Underline" Cursor="Hand"/>
                                                </TextBlock>
                                                <TextBlock Text="Supported: PDF, DOCX, ZIP, PNG, JPG" FontSize="11" 
                       Foreground="#999999" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Maximum 10MB per file" FontSize="11" 
                       Foreground="#999999" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>


                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="Cancel" 
                                                Background="#E0E0E0" 
                                                Foreground="#666666" 
                                                BorderThickness="0"
                                                Padding="35,12" 
                                                FontSize="15" 
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Margin="0,0,15,0"
                                                MouseLeftButtonDown="BackToCourseDetail">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="Submit Assignment" 
                                                Background="#6B7FD7" 
                                                Foreground="White" 
                                                BorderThickness="0"
                                                Padding="30,12" 
                                                FontSize="15" 
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT SECTION - Assignment Details -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <Border Background="White" CornerRadius="15" Padding="25">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📋 Assignment Details" FontSize="18" FontWeight="Bold" 
                                               FontFamily="{StaticResource MontserratFont}" Margin="0,0,0,20"/>

                                    <!-- Instructor -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Instructor" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Mr. Riza" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Posted Date -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Posted Date" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Dec 1, 2025" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Due Date -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Due Date" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Dec 25, 2025 - 23:59" FontSize="13" FontWeight="SemiBold" 
                                                   Foreground="#EF5350" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Max Score -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Max Score" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="100 Points" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Submission Type -->
                                    <Grid>
                                        <TextBlock Text="Submission Type" FontSize="13" Foreground="#666666"/>
                                        <TextBlock Text="Individual" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
