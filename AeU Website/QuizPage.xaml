<Window x:Class="EduPlus.QuizPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz - EduPlus" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="pack://application:,,,/Fonts/#Poppins">

    <Window.Resources>
        <FontFamily x:Key="PoppinsFont">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="MontserratFont">pack://application:,,,/Fonts/#Montserrat</FontFamily>

        <SolidColorBrush x:Key="PrimaryColor" Color="#32625A"/>
        <SolidColorBrush x:Key="DarkColor" Color="#1E484A"/>
        <SolidColorBrush x:Key="LightBackground" Color="#E8E8E8"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <StackPanel>
                <!-- Logo -->
                <StackPanel Margin="40,40,40,60">
                    <TextBlock Text="EduPlus" FontSize="28" FontWeight="Bold" 
                               FontFamily="{StaticResource MontserratFont}"
                               Foreground="White"/>
                    <TextBlock Text="Smart e-learning platform" FontSize="11" 
                               Foreground="#B8D3D2" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel>
                    <!-- Dashboard -->
                    <Border Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToDashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Site home -->
                    <Border Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="Site home" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- My Courses - Active -->
                    <Border Background="#2A5550" Padding="30,16" Cursor="Hand" MouseLeftButtonDown="NavigateToMyCourses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" FontSize="16" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="My Courses" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource LightBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="White" Padding="40,25" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Back Button & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="35" Height="35" Background="Transparent" Cursor="Hand" 
                                Margin="0,0,15,0" MouseLeftButtonDown="BackToCourseDetail">
                            <TextBlock Text="←" FontSize="24" Foreground="#333333" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Quiz: Midterm Exam" FontSize="32" FontWeight="Bold" 
                                   FontFamily="{StaticResource MontserratFont}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Timer -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="⏱️" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="59:53" FontSize="20" Foreground="#FF6B6B" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Question Counter -->
                        <Border Background="#E3F2FD" Padding="15,8" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Question 8/50" FontSize="16" Foreground="#1976D2" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- END QUIZ BUTTON - NEW -->
                        <Button Content="End Quiz" Background="#EF4444" Foreground="White" 
                    BorderThickness="0" Padding="25,10" FontSize="14" 
                    FontWeight="Bold" Cursor="Hand" Click="EndQuizButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}" 
                                            CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,40">

                    <!-- Question Navigator (Horizontal) -->
                    <Border Background="White" CornerRadius="12" Padding="25,20" Margin="0,0,0,25">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Questions Navigator" FontSize="16" FontWeight="Bold" 
                                       Margin="0,0,0,15"/>

                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                                    <Ellipse Width="12" Height="12" Fill="#6B7FD7" Margin="0,0,8,0"/>
                                    <TextBlock Text="Current" FontSize="12" Foreground="#666666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                                    <Ellipse Width="12" Height="12" Fill="#10B981" Margin="0,0,8,0"/>
                                    <TextBlock Text="Answered" FontSize="12" Foreground="#666666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#FFB84D" Margin="0,0,8,0"/>
                                    <TextBlock Text="Marked" FontSize="12" Foreground="#666666"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Question Numbers Grid -->
                            <WrapPanel>
                                <!-- Question 1 - Answered (Green) -->
                                <Border Width="45" Height="45" Background="#10B981" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="1" FontSize="16" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Question 2 - Answered (Green) -->
                                <Border Width="45" Height="45" Background="#10B981" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="2" FontSize="16" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Question 3-7 (Not Answered - Gray) -->
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="3" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="4" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="5" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="6" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="7" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Question 8 - Current (Blue) -->
                                <Border Width="45" Height="45" Background="#6B7FD7" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="8" FontSize="16" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Question 9-10 (Not Answered) -->
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="9" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="10" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- More questions... (11-14) -->
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="11" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="12" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="13" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="45" Height="45" Background="#E0E0E0" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="14" FontSize="16" Foreground="#666666" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Question 15 - Marked (Orange) -->
                                <Border Width="45" Height="45" Background="#FFB84D" CornerRadius="8" 
                                        Margin="0,0,10,10" Cursor="Hand">
                                    <TextBlock Text="15" FontSize="16" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Add more as needed... -->
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Question Card -->
                    <Border Background="White" CornerRadius="12" Padding="40">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Question Header -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Question 8" FontSize="18" Foreground="#666666"/>
                                <TextBlock Text="Points: 2" FontSize="14" Foreground="#6B7FD7" 
                                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Question Text -->
                            <TextBlock Text="Dalam pengembangan aplikasi mobile, manakah dari berikut ini yang BUKAN merupakan best practice untuk state management dengan menggunakan Provider pattern di Flutter?" 
                                       FontSize="16" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="26"/>

                            <!-- Answer Options -->
                            <StackPanel>
                                <!-- Option A -->
                                <Border Background="#F5F5F5" CornerRadius="10" Padding="20" Margin="0,0,0,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="24" Height="24" Stroke="#6B7FD7" StrokeThickness="2" 
                                                 Fill="Transparent" Margin="0,0,15,0"/>
                                        <TextBlock Text="Membuat multiple providers untuk state yang saling berhubungan" 
                                                   FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Option B -->
                                <Border Background="#F5F5F5" CornerRadius="10" Padding="20" Margin="0,0,0,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="24" Height="24" Stroke="#6B7FD7" StrokeThickness="2" 
                                                 Fill="Transparent" Margin="0,0,15,0"/>
                                        <TextBlock Text="Menggunakan Consumer widget hanya pada bagian UI yang membutuhkan rebuild" 
                                                   FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Option C -->
                                <Border Background="#F5F5F5" CornerRadius="10" Padding="20" Margin="0,0,0,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="24" Height="24" Stroke="#6B7FD7" StrokeThickness="2" 
                                                 Fill="Transparent" Margin="0,0,15,0"/>
                                        <TextBlock Text="Menyimpan semua business logic di dalam widget tanpa memisahkannya" 
                                                   FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Option D -->
                                <Border Background="#F5F5F5" CornerRadius="10" Padding="20" Margin="0,0,0,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="24" Height="24" Stroke="#6B7FD7" StrokeThickness="2" 
                                                 Fill="Transparent" Margin="0,0,15,0"/>
                                        <TextBlock Text="Menerapkan ChangeNotifier untuk state yang kompleks" 
                                                   FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Navigation Buttons -->
                            <Grid Margin="0,35,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Previous Button -->
                                    <Button Content="← Previous" Background="#E0E0E0" Foreground="#666666" 
                                            BorderThickness="0" Padding="30,12" FontSize="15" 
                                            FontWeight="SemiBold" Cursor="Hand" Margin="0,0,15,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Mark for Review Button -->
                                    <Button Content="Mark for Review" Background="#FFB84D" Foreground="White" 
                                            BorderThickness="0" Padding="25,12" FontSize="15" 
                                            FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Next Button -->
                                <Button Content="Next →" Background="#6B7FD7" Foreground="White" 
                                        BorderThickness="0" Padding="40,12" FontSize="15" 
                                        FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Submit Quiz Button (Show on last question) -->
                            <Button Content="Submit Quiz" Background="#10B981" Foreground="White" 
                                    BorderThickness="0" Padding="50,15" FontSize="16" 
                                    FontWeight="Bold" Cursor="Hand" Margin="0,20,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
